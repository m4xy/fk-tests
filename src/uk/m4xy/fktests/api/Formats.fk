import fckt.text.Format

// What a test says about formats, for any of them.
module Formats {
  // Fails unless format reads back value as it wrote it.
  assertReadsBack(format: Format, value: format.T): Unit = when (readBackProblem(format, value)) {
    Some(problem) -> error(problem)
    None -> Unit
  }

  // What's wrong with how format reads back value, if anything: said as the format writes it, as
  // it's all that can show any format's values.
  readBackProblem(format: Format, value: format.T): Option<String> = {
    written = format.of(value)
    when (format.read(written)) {
      Ok(read) ->
        if (read == value) None
        else if (format.of(read) == written) Some(
          "'$written' was read back as something else, which is written the same",
        )
        else Some("'$written' was read back as '${format.of(read)}'")
      Error(problem) -> Some("'$written' wasn't read back: $problem")
    }
  }
}
