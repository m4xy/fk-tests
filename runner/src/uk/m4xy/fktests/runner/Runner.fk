import fckt.io.Path
import fckt.io.Paths.*
import fckt.io.Process
import fckt.time.Clock
import uk.m4xy.fktests.runner.plan.*
import uk.m4xy.fktests.runner.execution.*
import uk.m4xy.fktests.runner.reporting.*
import fckt.effects.Fail
import fckt.io.Console
import fckt.io.Channel

// Runs tests written with fk-tests, as fckt --test's runner, --runner uk.m4xy.fktests.runner.Runner:
// fckt's main makes the plan of them with test, suite and plan, and gives it to main. Only that
// program uses it, never a test.
module Runner {
  // A test: fckt's main makes one for each function marked @Test, in file, a path from the tests'
  // folder, in the modules sections names there, which does effects, by their full names.
  test<@E>(
    file: String,
    sections: List<String>,
    name: String,
    line: Int,
    effects: List<String>,
    body: @Fail @Channel @E () -> Unit,
  ): TestCase<@E> =
    TestCase(TestId(path(file), sections, name), Location(path(file), line), effects, Single(body))

  // A test that gives its cases: fckt's main makes one for each function marked @Test that gives
  // anything but Unit, with around, which runs a case inside the test's fixtures.
  cases<@E, @F>(
    file: String,
    sections: List<String>,
    name: String,
    line: Int,
    effects: List<String>,
    given: @Fail @Channel @F () -> List<(String, @Fail @Channel @E () -> Unit)>,
    around: @Fail @Channel @F (@Fail @Channel @E () -> Unit) -> Unit,
  ): TestCase<@F> =
    TestCase(
      TestId(path(file), sections, name),
      Location(path(file), line),
      effects,
      Cases(() -> given().map { case, check -> (case, () -> around(check)) }),
    )

  // A file's tests.
  suite<@E>(file: String, tests: List<TestCase<@E>>): Suite<@E> = Suite(path(file), tests)

  // The tests there are to run.
  plan<@E>(suites: List<Suite<@E>>): Plan<@E> = Plan(suites)

  // Runs plan as args say, reported as they say, then exits with 1 if any test failed, or 2 if args
  // don't say what they mean. args choose which run, as selectorOf reads them; --without Network
  // skips the tests that do an effect, by its name or full name, and can be given again; each test
  // has --timeout seconds, or 300, to run, or as long as it takes with 0; --snapshots says where
  // they're kept, and --update-snapshots keeps them as they are now; --jobs says how many may run at
  // once, as jobsOf reads it; and --report lines reports as
  // LineReport does, for another program; ConsoleReport, for people, if not.
  @Console @Clock @Process main<@E>(
    args: List<String>,
    plan: Plan<@E>,
  ): Unit = when ((selectionOf(args), secondsOf(args), jobsOf(args))) {
    (Error(problem), _, _) -> refuse(problem)
    (_, Error(problem), _) -> refuse(problem)
    (_, _, Error(problem)) -> refuse(problem)
    (Ok(selection), Ok(seconds), Ok(jobs)) -> {
      valueOf(args, "--snapshots").forEach { setEnv("FK_TESTS_SNAPSHOTS", it) }
      if (args.contains("--update-snapshots")) setEnv("FK_TESTS_UPDATE_SNAPSHOTS", "1")
      report = if (reportOf(args) == Lines) LineReport else ConsoleReport
      summary = report { Execution.run(plan, selection, valuesOf(args, "--without"), seconds, jobs) }
      if (summary.failed > 0) exit(1)
    }
  }

  private notSeconds(
    text: String,
  ): String = "--timeout is a number of seconds, or 0 for as long as a test takes, not $text"

  @Console @Process private refuse(problem: String): Unit = {
    println("fk-tests: $problem")
    exit(2)
  }

  // How long args give each test, in seconds: --timeout's, or 300.
  secondsOf(args: List<String>): Result<Int, String> = when (valueOf(args, "--timeout")) {
    None -> Ok(300)
    Some(text) -> when (text.toIntOrNone()) {
      Some(seconds) -> if (seconds >= 0) Ok(seconds) else Error(notSeconds(text))
      None -> Error(notSeconds(text))
    }
  }

  // How many tests args say may run at once: --jobs's, or as many as the machine has cores.
  @Process jobsOf(args: List<String>): Result<Int, String> = when (valueOf(args, "--jobs")) {
    None -> Ok(cores(Unit))
    Some(text) -> when (text.toIntOrNone()) {
      Some(jobs) -> if (jobs >= 1) Ok(jobs) else Error(notJobs(text))
      None -> Error(notJobs(text))
    }
  }

  private notJobs(
    text: String,
  ): String = "--jobs is how many tests may run at once, 1 or more, not $text"

  private external cores(u: Unit): Int = "(fun _ -> Domain.recommended_domain_count ()) u"

  // The tests args choose: those their selectors do, or, without any, all.
  selectionOf(args: List<String>): Result<Selection, String> = {
    selectors = withoutOptions(args).map { selectorOf(it) }
    when (selectors.find { it.isError() }) {
      Some(Error(problem)) -> Error(problem)
      else -> {
        chosen = selectors.flatMap { s -> s.toOption().map { [it] }.getOrElse([]) }
        Ok(if (chosen.isEmpty()) All else Only(chosen))
      }
    }
  }

  // What an argument chooses, as pytest's are written: sums, every test of that name; prices.fk,
  // every test in that file; prices.fk::sums, that one test; prices.fk::Totals, the tests in that
  // section, as a module's name is capitalised; prices.fk::Totals.sums, that one test in it.
  selectorOf(arg: String): Result<Selector, String> = when (arg.split("::")) {
    [file, within] -> {
      parts = within.split(".")
      sections = parts.takeWhile { isSection(it) }
      rest = parts.drop(sections.size)
      if (!isFile(file) || !parts.all { isName(it) }) Error(unreadable(arg))
      else when (rest) {
        [] -> Ok(Section(path(file), sections))
        [name] -> if (isSection(name)) Error(unreadable(arg)) else Ok(
          Exactly(TestId(path(file), sections, name)),
        )
        else -> Error(unreadable(arg))
      }
    }
    [one] -> if (isFile(one)) Ok(File(path(one))) else if (isName(one)) Ok(Test(one)) else Error(
      unreadable(arg),
    )
    else -> Error(unreadable(arg))
  }

  // How args say to report: --report lines, for another program, or for people.
  reportOf(
    args: List<String>,
  ): Report = if (valueOf(args, "--report") == Some("lines")) Lines else Readable

  // What args give option, the last time they give it.
  private valueOf(
    args: List<String>,
    option: String,
  ): Option<String> = valuesOf(args, option).lastOrNone()

  // What args give option, each time they give it.
  private valuesOf(args: List<String>, option: String): List<String> = when (args) {
    [] -> []
    [o, value, *rest] -> if (o == option) [value] + valuesOf(rest, option) else valuesOf(
      [value] + rest,
      option,
    )
    [_] -> []
  }

  private isFile(text: String): Boolean = text.endsWith(".fk") && text.length > 3

  private isName(
    text: String,
  ): Boolean = text.isNotEmpty() && text.toList().all { it.isLetterOrDigit() || it == '_' }

  private isSection(
    text: String,
  ): Boolean = isName(text) && text.toList().firstOrNone().map { it.isUpperCase() }.getOrElse(false)

  private unreadable(arg: String): String =
    "can't tell which tests '$arg' means: a test's name, sums; a file, prices.fk; a file's test, prices.fk::sums; or a section of it, prices.fk::Totals"

  // args without the options and what they give, which leaves the selectors.
  private withoutOptions(args: List<String>): List<String> = when (args) {
    [] -> []
    [a, *rest] ->
      if (valued.contains(a)) withoutOptions(rest.drop(1))
      else if (a == "--update-snapshots") withoutOptions(rest)
      else [a] + withoutOptions(rest)
  }

  // The options that give something.
  private valued: List<String> = ["--report", "--without", "--timeout", "--snapshots", "--jobs"]

}
