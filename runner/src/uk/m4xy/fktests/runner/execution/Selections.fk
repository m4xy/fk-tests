import uk.m4xy.fktests.runner.plan.TestId

// Which tests a selection chooses.
module Selections {
  // Whether selection chooses the test id is.
  selects(selection: Selection, id: TestId): Boolean = when (selection) {
    All -> true
    Only(selectors) -> selectors.any(s -> chooses(s, id))
  }

  // Whether selector chooses the test id is.
  chooses(selector: Selector, id: TestId): Boolean = when (selector) {
    Test(name) -> id.name == name
    File(file) -> id.file == file
    Section(file, sections) -> id.file == file && id.sections.take(sections.size) == sections
    Exactly(wanted) -> id == wanted
  }
}
