import fckt.io.Path
import uk.m4xy.fktests.runner.plan.TestId

// What a test is chosen by.
type Selector {
  // Every test of that name.
  Test(name: String),
  // Every test in that file.
  File(file: Path),
  // Every test in those sections of that file, and in sections in them.
  Section(file: Path, sections: List<String>),
  // That one test.
  Exactly(id: TestId),
}
