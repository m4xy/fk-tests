import uk.m4xy.fktests.runner.plan.*
import uk.m4xy.fktests.runner.results.*
import uk.m4xy.fktests.runner.events.TestEvents
import fckt.time.*
import fckt.time.Times.*

// Running a plan: each suite with any test chosen, and each chosen test in it, telling TestEvents
// as it goes. What's chosen, how a test runs on its own, how long it takes and how the run went,
// it asks Selections, Isolation, Clock and Summaries.
module Execution {
  // Runs what selection chooses of plan, and says how it went.
  @TestEvents @Clock run<@E>(plan: Plan<@E>, selection: Selection): Summary = {
    started = now()
    results = plan.suites.flatMap { runSuite(it, selection) }
    summary = Summaries.of(results, started.until(now()))
    completed(summary)
    summary
  }

  // A suite's tests: those chosen run, between its start and finish; the others are skipped.
  @TestEvents @Clock private runSuite<@E>(
    suite: Suite<@E>,
    selection: Selection,
  ): List<TestResult> = {
    (chosen, others) = suite.cases.partition { Selections.selects(selection, it.id) }
    skipped = others.map { TestResult(it.id, Skipped, Duration(0)) }
    if (chosen.isEmpty()) skipped
    else {
      suiteStarted(suite.file)
      results = chosen.map { runCase(it) }
      suiteFinished(suite.file)
      results + skipped
    }
  }

  @TestEvents @Clock private runCase<@E>(test: TestCase<@E>): TestResult = {
    testStarted(test.id)
    started = now()
    outcome = Isolation.run(test.body)
    result = TestResult(test.id, outcome, started.until(now()))
    testFinished(result)
    result
  }
}
