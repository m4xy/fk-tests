import fckt.io.Path
import uk.m4xy.fktests.runner.plan.TestId
import uk.m4xy.fktests.runner.results.TestResult
import uk.m4xy.fktests.runner.results.Summary

// What a run tells whoever's listening, as it goes: each suite and test as it starts and finishes,
// then how it went. Execution tells it; a handler reports it, as reporting's do, or a test of the
// runner keeps it.
effect TestEvents {
  suiteStarted(suite: Path): Unit
  testStarted(id: TestId): Unit
  testFinished(result: TestResult): Unit
  suiteFinished(suite: Path): Unit
  completed(summary: Summary): Unit
}
