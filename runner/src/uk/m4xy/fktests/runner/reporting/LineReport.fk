import fckt.io.Path
import uk.m4xy.fktests.runner.plan.TestId
import uk.m4xy.fktests.runner.plan.TestIds.*
import uk.m4xy.fktests.runner.results.*
import uk.m4xy.fktests.runner.events.TestEvents
import fckt.io.Console

// Reports a run for another program, as fk-tests-kiln: an event a line, starting ##fk, then its
// fields, a tab before each, with what would end a field or a line escaped, \t, \n and \\:
//
//   ##fk  suite-started   prices.fk
//   ##fk  test-finished   prices.fk  sums  passed  3
//   ##fk  test-finished   prices.fk  empty  failed  1  expected:<1> but was:<0>
//   ##fk  completed  1  1  0  5
//
// A test's own output, which isn't, is on lines of its own between them.
module LineReport : TestEvents {
  @Console suiteStarted(suite: Path): Unit = event(["suite-started", suite.value])
  @Console testStarted(id: TestId): Unit = event(["test-started", id.file.value, id.qualifiedName])
  @Console testFinished(result: TestResult): Unit = event(["test-finished", result.id.file.value, result.id.qualifiedName] + when (result.outcome) {
    Passed -> ["passed", result.took.millis.toString()]
    Failed(failure) -> ["failed", result.took.millis.toString(), failure.message]
    Skipped -> ["skipped", "0"]
  })
  @Console suiteFinished(suite: Path): Unit = event(["suite-finished", suite.value])
  @Console completed(summary: Summary): Unit =
    event(
      [
        "completed",
        summary.passed.toString(),
        summary.failed.toString(),
        summary.skipped.toString(),
        summary.took.millis.toString(),
      ],
    )

  @Console private event(fields: List<String>): Unit = println((["##fk"] + fields.map { escape(it) }).joinToString("\t"))

  private escape(field: String): String = field.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n")
}
