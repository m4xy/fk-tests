// Runs tests written with fk-tests, as fckt --test's runner, --runner uk.m4xy.fktestsrunner.Testing:
// fckt's main gives it the plan of them. Each runs on its own, so one that fails doesn't stop the
// others, telling TestEvents as it goes, and the program exits with 1 if any failed. Only that
// program uses it, never a test.
module Testing {
  // Runs plan as args say: patterns choosing which run, as Selection has them, and --report lines,
  // to report as LineReport does, for another program.
  @Console main<@E>(args: List<String>, plan: Plan<@E>): Unit = {
    report = if (reportOf(args) == Lines) LineReport else ConsoleReport
    summary = report { run(plan, selectionOf(args)) }
    if (summary.failed > 0) stop(1)
  }

  // Runs what selection chooses of plan, each suite with any chosen, and says how it went.
  @TestEvents run<@E>(plan: Plan<@E>, selection: Selection): Summary = {
    started = now()
    results = plan.suites.flatMap(suite -> runSuite(suite, selection))
    summary = Summary(
      results.count(r -> r.outcome == Passed),
      results.count(r -> when (r.outcome) {
        Failed(_) -> true
        else -> false
      }),
      results.count(r -> r.outcome == Skipped),
      millisSince(started),
    )
    completed(summary)
    summary
  }

  @TestEvents private runSuite<@E>(suite: Suite<@E>, selection: Selection): List<TestResult> = {
    chosen = suite.cases.filter(c -> selects(selection, c.id))
    skipped = suite.cases.filter(c -> !selects(selection, c.id)).map(c -> TestResult(c.id, Skipped, 0))
    if (chosen.isEmpty()) skipped
    else {
      suiteStarted(suite.file)
      results = chosen.map(c -> runCase(c))
      suiteFinished(suite.file)
      results + skipped
    }
  }

  // Runs a test on its own: what stops it, a failed assertion, fail(...) or an exception, fails it.
  @TestEvents private runCase<@E>(test: TestCase<@E>): TestResult = {
    testStarted(test.id)
    started = now()
    outcome = when (attempt { caught(test.body).map(reason -> fail(reason)).getOrElse(Unit) }) {
      Ok(_) -> Passed
      Error(reason) -> Failed(Failure(reason))
    }
    result = TestResult(test.id, outcome, millisSince(started))
    testFinished(result)
    result
  }

  // Whether selection chooses the test id is.
  selects(selection: Selection, id: TestId): Boolean = when (selection) {
    All -> true
    Only(patterns) -> {
      stem = id.file.removeSuffix(".fk")
      patterns.any(p -> p == id.name || p == stem || p == "$stem.${id.name}")
    }
  }

  // The tests args choose: those its patterns name, or all.
  selectionOf(args: List<String>): Selection = {
    patterns = withoutOptions(args)
    if (patterns.isEmpty()) All else Only(patterns)
  }

  // How args say to report: --report lines, for another program, or for people.
  reportOf(args: List<String>): Report = when (args) {
    [] -> Readable
    ["--report", "lines", *_] -> Lines
    [_, *rest] -> reportOf(rest)
  }

  private withoutOptions(args: List<String>): List<String> = when (args) {
    [] -> []
    ["--report", _, *rest] -> withoutOptions(rest)
    [a, *rest] -> [a] + withoutOptions(rest)
  }

  private millisSince(started: Float): Int = ((now() - started) * 1000.0).toInt()

  // What stopped body, an assertion that failed or an OCaml exception, if anything did.
  private external caught(body: () -> Unit): Option<String> =
    "(fun f -> try f (); None with Failure m -> Some m | e -> Some (Printexc.to_string e)) body"

  private external now(): Float = "Unix.gettimeofday ()"

  private external stop(code: Int): Unit = "exit code"
}
