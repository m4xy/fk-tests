// Reports a run for another program, as fk-tests-kiln: an event a line, starting ##fk, then its
// fields, a tab before each, with what would end a field or a line escaped, \t, \n and \\:
//
//   ##fk  suite-started   prices.fk
//   ##fk  test-finished   prices.fk  sums  passed  3
//   ##fk  test-finished   prices.fk  empty  failed  1  expected:<1> but was:<0>
//   ##fk  completed  1  1  0  5
//
// A test's own output, which isn't, is on lines of its own between them.
module LineReport : TestEvents {
  @Console suiteStarted(suite: String): Unit = event(["suite-started", suite])
  @Console testStarted(id: TestId): Unit = event(["test-started", id.file, id.name])
  @Console testFinished(result: TestResult): Unit = event(["test-finished", result.id.file, result.id.name] + when (result.outcome) {
    Passed -> ["passed", result.millis.toString()]
    Failed(failure) -> ["failed", result.millis.toString(), failure.message]
    Skipped -> ["skipped", "0"]
  })
  @Console suiteFinished(suite: String): Unit = event(["suite-finished", suite])
  @Console completed(summary: Summary): Unit =
    event(["completed", summary.passed.toString(), summary.failed.toString(), summary.skipped.toString(), summary.millis.toString()])

  @Console private event(fields: List<String>): Unit = println((["##fk"] + fields.map(f -> escape(f))).joinToString("\t"))

  private escape(field: String): String = field.split("\\").joinToString("\\\\").split("\t").joinToString("\\t").split("\n").joinToString("\\n")
}
