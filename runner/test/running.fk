import uk.m4xy.fktests.api.Test
import uk.m4xy.fktests.runner.Runner
import uk.m4xy.fktests.runner.events.TestEvents
import uk.m4xy.fktests.runner.execution.*
import uk.m4xy.fktests.runner.results.*
import fckt.time.*

plan = Runner.plan([Runner.suite("prices.fk", [
  Runner.test("prices.fk", [], "sums", 3) { assert(1 + 1 == 2) },
  Runner.test("prices.fk", [], "empty", 4) { assertEquals(1, 2) },
  Runner.test("prices.fk", [], "divides", 5) { assert(1 / 0 == 0) },
])])

// What a run tells TestEvents, as a handler that keeps it has it, on a clock that moves 5ms each
// time it's asked.
heard(selection: Selection): List<String> = {
  var events = []
  var time = 0
  TestEvents(
    suiteStarted = suite -> { events = events + ["started ${suite.value}"] },
    testStarted = id -> { events = events + ["started ${id.name}"] },
    testFinished = result -> { events = events + ["finished ${result.id.name} in ${result.took.millis}ms: ${outcomeOf(result.outcome)}"] },
    suiteFinished = suite -> { events = events + ["finished ${suite.value}"] },
    completed = summary -> { events = events + ["${summary.passed} passed, ${summary.failed} failed, ${summary.skipped} skipped, in ${summary.took.millis}ms"] },
  ) {
    Clock(now = () -> {
      time = time + 5
      Instant(time)
    }) { Execution.run(plan, selection) }
  }
  events
}

outcomeOf(outcome: Outcome): String = when (outcome) {
  Passed -> "passed"
  Failed(failure) -> "failed, ${failure.message}"
  Skipped -> "skipped"
}

// Each test runs on its own: one failing, or crashing, doesn't stop the others.
@Test eachTestRunsOnItsOwn() = assertEquals(
  [
    "started prices.fk",
    "started sums", "finished sums in 5ms: passed",
    "started empty", "finished empty in 5ms: failed, running.fk line 10: expected:<1> but was:<2>",
    "started divides", "finished divides in 5ms: failed, Division_by_zero",
    "finished prices.fk",
    "1 passed, 2 failed, 0 skipped, in 35ms",
  ],
  heard(Selection.All),
)

// What isn't chosen is skipped, without being started.
@Test whatIsntChosenIsSkipped() = assertEquals(
  ["started prices.fk", "started sums", "finished sums in 5ms: passed", "finished prices.fk", "1 passed, 0 failed, 2 skipped, in 15ms"],
  heard(Selection.Only([Selector.Test("sums")])),
)
