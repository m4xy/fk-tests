import uk.m4xy.fktests.Test
import uk.m4xy.fktestsrunner.Testing
import uk.m4xy.fktestsrunner.Selection
import uk.m4xy.fktestsrunner.TestId

sums = TestId("prices.fk", "sums")

@Test allRunWithoutArguments() = assert(Testing.selects(Testing.selectionOf([]), sums))

@Test aTestIsChosenByName() = {
  assert(Testing.selects(Testing.selectionOf(["sums"]), sums))
  assert(!Testing.selects(Testing.selectionOf(["empty"]), sums))
}

@Test aTestIsChosenByFile() = {
  assert(Testing.selects(Testing.selectionOf(["prices"]), sums))
  assert(Testing.selects(Testing.selectionOf(["prices.sums"]), sums))
  assert(!Testing.selects(Testing.selectionOf(["receipts.sums"]), sums))
}

@Test optionsArentPatterns() = {
  assertEquals(Selection.All, Testing.selectionOf(["--report", "lines"]))
  assert(Testing.reportOf(["sums", "--report", "lines"]) == uk.m4xy.fktestsrunner.Report.Lines)
}
