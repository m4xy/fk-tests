import uk.m4xy.fktestsrunner.Testing

// The arguments choose which tests run.
main() = {
  assert(Testing.selected([], "prices.fk", "sums"))
  assert(Testing.selected(["sums"], "prices.fk", "sums"))
  assert(!Testing.selected(["empty"], "prices.fk", "sums"))
  assert(Testing.selected(["prices"], "prices.fk", "sums"))
  assert(Testing.selected(["prices.sums"], "prices.fk", "sums"))
  assert(!Testing.selected(["receipts.sums"], "prices.fk", "sums"))
}
