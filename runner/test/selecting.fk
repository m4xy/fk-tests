import uk.m4xy.fktests.api.Test
import uk.m4xy.fktests.runner.Runner
import uk.m4xy.fktests.runner.execution.Execution
import uk.m4xy.fktests.runner.execution.Selection
import uk.m4xy.fktests.runner.plan.TestId
import uk.m4xy.fktests.runner.reporting.Report

sums = TestId("prices.fk", "sums")

chosen(args: List<String>): Boolean = Execution.selects(Runner.selectionOf(args), sums)

@Test allRunWithoutArguments() = assert(chosen([]))

@Test aTestIsChosenByName() = {
  assert(chosen(["sums"]))
  assert(!chosen(["empty"]))
}

@Test aTestIsChosenByFile() = {
  assert(chosen(["prices"]))
  assert(chosen(["prices.sums"]))
  assert(!chosen(["receipts.sums"]))
}

@Test optionsArentPatterns() = {
  assertEquals(Selection.All, Runner.selectionOf(["--report", "lines"]))
  assert(Runner.reportOf(["sums", "--report", "lines"]) == Report.Lines)
}
