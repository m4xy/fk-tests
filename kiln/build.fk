// fk-tests-kiln: fk-tests as a kiln plugin, FkTests, whose task runs a project's functions marked
// @Test. It makes tasks with kiln's library, which kiln has. Its own tests use it,
// fk-tests and the runner, from here.
import uk.m4xy.kiln.fckt.Fckt
import uk.m4xy.fktests.kiln.*

project = Project(name = "fk-tests-kiln", group = "uk.m4xy", version = "0.1.0", dependencies = [kiln()])

// Its tests are written with fk-tests, and run by the runner, as they are here.
module OwnTests : TestConfiguration {
  roots(): List<TestRoot> = [TestRoot(path("test"), uses = [projectAt("..")])]
  runner(): TestRunner = TestRunner(uses = [projectAt("../runner")])
}

plugins = [Fckt(), FkTests(OwnTests)]
