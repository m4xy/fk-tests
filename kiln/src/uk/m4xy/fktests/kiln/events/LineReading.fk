// Reading what the test program prints, as fk-tests-runner's LineReport reports a run.
module LineReading {
  // A line as LineReport writes an event, ##fk and its fields, a tab before each; or output.
  parse(line: String): RunnerLine =
    if (!line.startsWith("##fk\t")) Output(line)
    else when (line.split("\t").drop(1).map { unescape(it) }) {
      ["suite-started", file] -> SuiteStarted(file)
      ["test-finished", _, name, outcome, _] -> TestFinished(name, outcome, "")
      ["test-finished", _, name, outcome, _, message] -> TestFinished(name, outcome, message)
      ["completed", passed, failed, skipped, _] -> Completed(count(passed), count(failed), count(skipped))
      else -> Ignored
    }

  private count(field: String): Int = field.toIntOrNone().getOrElse(0)

  // A field as it was before LineReport escaped it: \t, \n and \\ back to a tab, a newline and \.
  private unescape(field: String): String =
    field.split("\\\\").map { it.replace("\\t", "\t").replace("\\n", "\n") }.joinToString("\\")
}
