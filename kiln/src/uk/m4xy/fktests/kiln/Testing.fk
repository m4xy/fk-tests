import fckt.io.Path
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*
import fckt.io.FileSystem
import fckt.io.Console
import uk.m4xy.kiln.*
import uk.m4xy.kiln.Dependencies.*
import uk.m4xy.kiln.fckt.*
import uk.m4xy.kiln.fckt.Compiling.*
import uk.m4xy.kiln.fckt.Programs.rememberScope
import uk.m4xy.kiln.fckt.Resolving.resolve
import uk.m4xy.kiln.fckt.Sources.allSources
import uk.m4xy.fktests.kiln.events.*
import fckt.effects.Fail
import fckt.text.Digests.*

// Running a project's tests: each root's, compiled by fckt to a program that the runner runs, each
// test on its own.
module Testing {
  // Runs the tests in each of roots with runner, those of a root together, in a project laid out as
  // layout says; files, what they run or read besides their own code; each given seconds to run.
  @Building runAll(
    build: Invocation,
    layout: FcktLayout,
    roots: List<TestRoot>,
    runner: TestRunner,
    files: List<Path>,
    seconds: Int = 300,
  ): Unit =
    roots.forEach { root ->
      if (roots.size > 1) println("  ${root.folder.value}/")
      test(build, layout, root.uses, root.folder, runner, files, seconds)
    }

  // Runs the tests, unless they passed, would be compiled from what they were, and files are what
  // they were, and nothing chooses which.
  @Building private test(
    build: Invocation,
    layout: FcktLayout,
    uses: List<Dependency>,
    folder: Path,
    runner: TestRunner,
    files: List<Path>,
    seconds: Int,
  ): Unit = {
    project = build.project
    marked = if (folder.isDirectory()) folder.listFiles().filter { it.extension == "fk" && hasTests(it) } else []
    if (marked.isEmpty()) println("  no tests in ${folder.value}")
    else {
      tests = resolve(project.copy(dependencies = project.dependencies + uses), layout)
      resolved = resolve(
        project.copy(dependencies = project.dependencies + uses + runner.uses),
        layout,
      )
      linking = linking(resolved)
      // The tests see what's internal to the project, as its own code does, but not to the projects it uses.
      // For editors: the tests' files see what they're written with, but not the runner.
      rememberScope(
        folder.name,
        folder,
        linking.libraries.filter { tests.libraries.contains(it.coordinates) },
      )
      // What the tests kept, which they check against, is theirs too.
      snapshots = folder.resolve("snapshots")
      kept = if (snapshots.isDirectory()) keptIn(snapshots) else []
      inputs = inputs(
        linking,
        resolved.roots + [folder],
        [],
      ) + runner.runner + runner.marker + "$seconds" +
        (files + kept).map { f -> "${f.value} ${if (f.exists()) f.readBytes().md5() else "missing"}" }.joinToString("\n")
      output = project.output.resolve("tests").resolve(folder.name)
      program = output.resolve("tests")
      passed = output.resolve("passed")
      summary = output.resolve("summary")
      if (build.args.isEmpty() && passed.exists() && passed.readText() == inputs && program.exists()) {
        println("  ${summary.readText()} (up to date)")
      } else {
        passed.delete()
        buildProgram(project.output, program, inputs) { ml ->
          runOrFail(compiler(), ["--test", folder.value, "--marker", runner.marker, "--fixtures", runner.fixtures, "--runner", runner.runner, "-o", ml.value, "--separate", "--no-std"] +
            (if (runner.uses.isEmpty()) ["--runner-tests"] else []) +
            sourceArgs(layout.allSources(), resolved.roots) + interfaces(linking.libraries))
          linkProgram(linking, ml, program)
        }
        exit = run(
          program.value,
          [
            "--report",
            "lines",
            "--snapshots",
            snapshots.value,
            "--timeout",
            "$seconds",
          ] + build.args,
        )
        lines = exit.value.trim().split("\n").map { LineReading.parse(it) }
        lines.forEach { show(it) }
        completed = lines.find { line ->
          when (line) {
            Completed(_, _, _) -> true
            else -> false
          }
        }
        when (completed) {
          Some(Completed(passedCount, failedCount, skippedCount)) -> {
            if (failedCount > 0 || exit.code != 0) fail("tests failed")
            if (build.args.isEmpty()) {
              summary.writeText(summaryOf(passedCount, failedCount, skippedCount))
              passed.writeText(inputs)
            }
          }
          else -> fail("the tests stopped before they'd all run")
        }
      }
    }
  }

  // Shows a line of the run under the task: each file, its tests, then how many passed.
  @Console private show(line: RunnerLine): Unit = when (line) {
    SuiteStarted(file) -> println("  $file")
    TestFinished(name, "passed", _) -> println("    passed $name")
    TestFinished(name, "failed", message) -> println(
      "    FAILED $name: ${message.replace("\n", "\n      ")}",
    )
    TestFinished(_, _, _) -> Unit
    Completed(passed, failed, skipped) -> println("  ${summaryOf(passed, failed, skipped)}")
    Output(text) -> println("  $text")
    Ignored -> Unit
  }

  private summaryOf(passed: Int, failed: Int, skipped: Int): String =
    if (passed + failed == 0) "no tests ran"
    else "$passed passed, $failed failed" + (if (skipped > 0) ", $skipped skipped" else "")

  // The snapshots kept in folder, and in folders in it.
  @FileSystem private keptIn(
    folder: Path,
  ): List<Path> = folder.listFiles().flatMap { if (it.isDirectory()) keptIn(it) else [it] }

  // Whether the file marks a function @Test, on a line of its own.
  @FileSystem private hasTests(
    file: Path,
  ): Boolean = file.readLines().any { it.startsWith("@Test ") }
}
