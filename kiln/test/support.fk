import fckt.io.Path
import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Exit
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*

// What the tests share: projects to build, in build/test-projects, with the kiln KILN says, and
// fk-tests, its runner and this plugin from this repository.

@Process here(): String = run("pwd", []).value.trim()

// A fresh folder for a test's project.
@FileSystem @Process project(name: String): Path = {
  folder = path(here()).resolve("build/test-projects").resolve(name)
  folder.delete()
  folder.makeDirs()
  folder
}

// Writes text to file, in folder, making the folders it's in.
@FileSystem write(folder: Path, file: String, text: String): Unit = {
  target = folder.resolve(file)
  when (target.parent) {
    Some(parent) -> parent.makeDirs()
    None -> Unit
  }
  target.writeText(text)
}

// A project, name, in folder, whose tests are run by this repository's plugin and runner, and
// written with its fk-tests: its settings.fk and build.fk.
@FileSystem @Process testedProject(folder: Path, name: String): Unit = {
  repo = path(here()).resolve("..").value
  // An item to a line, as fckt --format has a list too wide for its line, which a long path makes it.
  write(
    folder,
    "settings.fk",
    "settings = Settings(\n  uses = [\n    projectAt(\n      \"$repo/kiln\",\n    ),\n  ],\n)\n",
  )
  write(folder, "build.fk", """import uk.m4xy.kiln.fckt.Fckt
import uk.m4xy.fktests.kiln.*

project = Project(name = "$name")

repo = "$repo"

module Tests : TestConfiguration {
  roots(): List<TestRoot> = [TestRoot(path("test"), uses = [projectAt(repo)])]
  runner(): TestRunner = TestRunner(uses = [projectAt(repo + "/runner")])
}

plugins = [Fckt(), FkTests(Tests)]
""")
}

// Runs kiln in folder with args: what it printed, and its exit code.
@Process kiln(folder: Path, args: List<String>): Exit<String> = {
  kiln = env("KILN").getOrElse("kiln")
  run("sh", ["-c", "cd \"\$1\" && shift && exec \"\$@\" 2>&1", "sh", folder.value, kiln] + args)
}

// Fails, saying what was expected and what there was, unless text contains part.
expectContains(
  text: String,
  part: String,
): Unit = if (!text.contains(part)) error("expected to find:\n$part\nin:\n$text")
