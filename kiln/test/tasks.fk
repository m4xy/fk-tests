import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Paths.*
import fckt.io.Files.*
import uk.m4xy.fktests.api.Test

prices = "module Prices {\n  total(items: List<Int>): Int = items.sum()\n}\n"

// The functions marked @Test run as part of check, so of build; what's up to date doesn't run again,
// and what follows -- chooses which do.
@Test @FileSystem @Process testsArePartOfCheck() = {
  till = project("till")
  write(till, "src/pricing/Prices.fk", prices)
  write(
    till,
    "test/prices.fk",
    "import uk.m4xy.fktests.api.Test\nimport pricing.Prices\n\n@Test sums() = assert(Prices.total([1, 2, 3]) == 6)\n@Test empty() = assert(Prices.total([]) == 0)\n",
  )
  testedProject(till, "till")
  built = kiln(till, ["build"]).value
  expectContains(
    built,
    "> Task :test\n  prices.fk\n    passed sums\n    passed empty\n  2 passed, 0 failed\n> Task :check\n> Task :build\nBUILD SUCCESSFUL\n",
  )
  expectContains(kiln(till, ["check"]).value, "> Task :test\n  2 passed, 0 failed (up to date)\n")
  expectContains(
    kiln(till, ["test", "--", "empty"]).value,
    "> Task :test\n  prices.fk\n    passed empty\n  1 passed, 0 failed, 1 skipped\n",
  )
}

// A failing test fails the build.
@Test @FileSystem @Process aFailingTestFailsTheBuild() = {
  till = project("failing")
  write(till, "src/pricing/Prices.fk", prices)
  write(
    till,
    "test/wrong.fk",
    "import uk.m4xy.fktests.api.Test\n\n@Test adds() = assertEquals(3, 1 + 1)\n",
  )
  testedProject(till, "failing")
  wrong = kiln(till, ["build"])
  assertEquals(1, wrong.code)
  expectContains(
    wrong.value,
    "    FAILED adds: wrong.fk line 3: assertEquals(3, 1 + 1) failed\n        expected: 3\n        actual:   2\n  0 passed, 1 failed\nBUILD FAILED: tests failed",
  )
}

// The tests see what they're written with, but not the runner; the program sees neither.
@Test @FileSystem @Process onlyTheTestsSeeWhatTheyreWrittenWith() = {
  till = project("seeing")
  write(till, "src/pricing/Prices.fk", prices)
  testedProject(till, "seeing")
  write(
    till,
    "test/sneaky.fk",
    "import uk.m4xy.fktests.api.Test\nimport uk.m4xy.fktests.runner.Runner\n\n@Test sneaks() = Unit\n",
  )
  expectContains(
    kiln(till, ["test"]).value,
    "uk.m4xy.fktests.runner runs the tests, so they can't use it",
  )
  write(till, "test/sneaky.fk", "import uk.m4xy.fktests.api.Test\n\n@Test sneaks() = Unit\n")
  kiln(till, ["test"])
  expectContains(till.resolve(".kiln/scopes/test").readText(), "folder test\n")
  write(till, "src/main.fk", "import uk.m4xy.fktests.api.Test\n\nmain() = println(\"till\")\n")
  expectContains(kiln(till, ["compile"]).value, "uk.m4xy.fktests")
}

// A configuration says where tests are: each folder's are run together, and what each folder is
// written with is its own.
@Test @FileSystem @Process eachRootsTestsRunTogether() = {
  till = project("roots")
  write(till, "src/pricing/Prices.fk", prices)
  write(
    till,
    "test/prices.fk",
    "import uk.m4xy.fktests.api.Test\nimport pricing.Prices\n\n@Test sums() = assert(Prices.total([1, 2]) == 3)\n",
  )
  write(
    till,
    "integration/till.fk",
    "import uk.m4xy.fktests.api.Test\nimport pricing.Prices\n\n@Test rings() = assert(Prices.total([5]) == 5)\n",
  )
  testedProject(till, "roots")
  repo = path(here()).resolve("..").value
  write(till, "build.fk", """import uk.m4xy.kiln.fckt.Fckt
import uk.m4xy.fktests.kiln.*

project = Project(name = "roots")

repo = "$repo"

module Both : TestConfiguration {
  roots(): List<TestRoot> = [
    TestRoot(path("test"), uses = [projectAt(repo)]),
    TestRoot(path("integration"), uses = [projectAt(repo)]),
  ]
  runner(): TestRunner = TestRunner(uses = [projectAt(repo + "/runner")])
}

plugins = [Fckt(), FkTests(Both)]
""")
  expectContains(
    kiln(till, ["tasks"]).value,
    "  test - Runs the functions marked @Test in test, integration",
  )
  expectContains(
    kiln(till, ["test"]).value,
    "> Task :test\n  test/\n  prices.fk\n    passed sums\n  1 passed, 0 failed\n  integration/\n  till.fk\n    passed rings\n  1 passed, 0 failed\n",
  )
}

// Tests in a module are in its section, which chooses them, and they're named through.
@Test @FileSystem @Process aSectionChoosesItsTests() = {
  till = project("sections")
  write(till, "src/pricing/Prices.fk", prices)
  write(
    till,
    "test/prices.fk",
    "import uk.m4xy.fktests.api.Test\nimport pricing.Prices\n\n@Test sums() = assert(Prices.total([1]) == 1)\n\nmodule Empty {\n  @Test totalsNothing() = assert(Prices.total([]) == 0)\n}\n",
  )
  testedProject(till, "sections")
  expectContains(
    kiln(till, ["test"]).value,
    "  prices.fk\n    passed sums\n    passed Empty.totalsNothing\n  2 passed, 0 failed\n",
  )
  expectContains(
    kiln(till, ["test", "--", "prices.fk::Empty"]).value,
    "  prices.fk\n    passed Empty.totalsNothing\n  1 passed, 0 failed, 1 skipped\n",
  )
}

// A test that gives its cases has each reported on its own; a failed assertion says what it checked
// and how it went; and a test that does an effect it's run without is skipped.
@Test @FileSystem @Process casesAndEffects() = {
  till = project("cases")
  write(till, "src/pricing/Prices.fk", prices)
  write(
    till,
    "test/prices.fk",
    """import uk.m4xy.fktests.api.Test
import uk.m4xy.fktests.api.Cases.*
import fckt.io.Console
import pricing.Prices

@Test sums() = cases([("pair", ([1, 2], 3)), ("empty", ([], 1))]) { items, total ->
  assertEquals(total, Prices.total(items))
}

@Test @Console says() = println("hello")
""",
  )
  testedProject(till, "cases")
  tested = kiln(till, ["test"])
  assertEquals(1, tested.code)
  expectContains(
    tested.value,
    "    passed sums[pair]\n    FAILED sums[empty]: prices.fk line 7: assertEquals(total, Prices.total(items)) failed\n        expected: 1\n        actual:   0\n",
  )
  expectContains(tested.value, "  hello\n    passed says\n  2 passed, 1 failed\n")
  expectContains(
    kiln(till, ["test", "--", "--without", "Console"]).value,
    "  1 passed, 1 failed, 1 skipped\n",
  )
}

// What a test keeps as a snapshot is checked against next time, and says how it differs; it's kept
// as it is now with --update-snapshots; and where CI is set, one that's missing fails.
@Test @FileSystem @Process snapshotsAreKeptThenChecked() = {
  till = project("snapshots")
  write(till, "src/pricing/Prices.fk", prices)
  receipt = (thanks: String) -> """import uk.m4xy.fktests.api.*
import uk.m4xy.fktests.api.Snapshot.*
import pricing.Prices

@Test @Snapshots receipt() = assertSnapshot("receipt", "total ${'$'}{Prices.total([1, 2])}\n$thanks")
"""
  write(till, "test/receipt.fk", receipt("thanks"))
  testedProject(till, "snapshots")
  ci = env("CI").getOrElse("")
  setEnv("CI", "")
  expectContains(kiln(till, ["test"]).value, "    passed receipt\n  1 passed, 0 failed\n")
  assertEquals("total 3\nthanks", till.resolve("test/snapshots/receipt.txt").readText())
  write(till, "test/receipt.fk", receipt("thank you"))
  changed = kiln(till, ["test"])
  assertEquals(1, changed.code)
  expectContains(
    changed.value,
    "    FAILED receipt: snapshot receipt isn't what was kept in test/snapshots/receipt.txt, which is expected:\n" +
      "        - expected, + actual:\n          total 3\n        - thanks\n        + thank you\n" +
      "        kiln test -- --update-snapshots keeps it as it is now\n",
  )
  expectContains(kiln(till, ["test", "--", "--update-snapshots"]).value, "    passed receipt\n")
  assertEquals("total 3\nthank you", till.resolve("test/snapshots/receipt.txt").readText())
  // What's kept is the tests' too: they run again when it changes.
  expectContains(kiln(till, ["test"]).value, "    passed receipt\n  1 passed, 0 failed\n")
  write(till, "test/snapshots/receipt.txt", "total 3\nthanks")
  assertEquals(1, kiln(till, ["test"]).code)
  till.resolve("test/snapshots/receipt.txt").delete()
  setEnv("CI", "true")
  missing = kiln(till, ["test"])
  setEnv("CI", ci)
  assertEquals(1, missing.code)
  expectContains(
    missing.value,
    "    FAILED receipt: no snapshot receipt: keep one with kiln test -- --update-snapshots, then commit test/snapshots/receipt.txt\n",
  )
}
